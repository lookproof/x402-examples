# Wallet used to pay for x402 calls. Use a dedicated wallet with a few dollars of
# USDC on Base mainnet. Never your main wallet. Never commit your real .env.
# Set ONE of these:
#   PRIVATE_KEY_FILE  path to a file that holds the key (chmod 600), recommended
#   PRIVATE_KEY       the key itself (0x-prefixed hex)
PRIVATE_KEY_FILE=
PRIVATE_KEY=

# Examples run as a dry run by default: they show the price, network and payTo
# address from the 402 response without paying.
# Set X402_PAY=1 (or pass --pay) to actually pay.
X402_PAY=

# Optional: comma-separated payTo addresses you are willing to pay. When set,
# a 402 that asks for payment to any other address is refused before signing.
# Empty = pay whichever payTo the 402 response names (still locked per request).
PAYTO_ALLOWLIST=

# Hard spending cap per run (per session for the MCP server), in USD.
MAX_SPEND_USD=0.10

# --- domain-monitor --------------------------------------------------------

# Domains to check: comma-separated, or a file with one domain per line.
DOMAINS=
DOMAINS_FILE=
# Where the latest result per domain is kept (default: domain-monitor/.monitor-state.json).
STATE_FILE=
# Alert on any change (change, default) or only when a check gets weaker (weaker).
ALERT_ON=change
# Comma-separated: stdout (default), discord, telegram, email.
DELIVERY=stdout

DISCORD_WEBHOOK_URL=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=
